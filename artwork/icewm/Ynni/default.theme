# Ynni - the nni family icewm theme (crimson, amber and chick yellow)
ThemeDescription="Ynni: crimson and amber, from the YnniOS wallpapers"
ThemeAuthor="nni project"
Look=flat
Gradients=""

TitleFontNameXft="sans-serif:size=10:bold"
MenuFontNameXft="sans-serif:size=10"
StatusFontNameXft="monospace:size=10"
NormalTaskBarFontNameXft="sans-serif:size=10"
ActiveTaskBarFontNameXft="sans-serif:size=10:bold"
ToolTipFontNameXft="sans-serif:size=9"
ClockFontNameXft="monospace:size=10:bold"

BorderSizeX=3
BorderSizeY=3
DlgBorderSizeX=2
DlgBorderSizeY=2
TitleBarHeight=22
TitleBarJustify=0
TitleBarHorzOffset=6

ColorActiveBorder="rgb:7A/0E/24"
