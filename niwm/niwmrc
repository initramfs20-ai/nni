# niwmrc - NiWM configuration
#
# Copy to ~/.config/niwm/niwmrc and edit. Every line is a NiWM command,
# the same ones `niwmctl` sends, so you can try any line live first:
#   niwmctl set gap 10
# Reload this file with mod+ctrl+r or `niwmctl reload`.

# ---- look ---------------------------------------------------------------
set border 2
set gap 6
set focus_color #c23b3b
set normal_color #3a3a3a
set urgent_color #e0a030
# no border when a window is alone or in monocle
set smart_borders yes
# extra empty space at the top/bottom (pixels). Bars such as nibar
# reserve their own space, so these are usually 0.
set pad_top 0
set pad_bottom 0

# ---- behaviour ------------------------------------------------------------
# mod is super, alt or ctrl
set mod super
set tags 9
set layout tile
set mfact 0.55
set nmaster 1
set focus_follows_mouse no
# swallowing: a program started from a terminal (mpv, an image viewer)
# takes the terminal's place until it closes. Per app: rule ... noswallow
set swallow yes

# ---- programs ---------------------------------------------------------------
# niwm sets $TERMINAL to the first terminal it finds installed. To choose
# one, uncomment this (keep it above the autostart lines):
# set terminal lxterminal
bind mod+Return spawn $TERMINAL
# drop-down scratchpad: the first press starts it, then it hides and
# comes back with whatever was running. On a US keyboard you may prefer
# mod+grave (the key left of 1).
bind mod+s scratchpad $TERMINAL
# set scratchpad_size 60x45
bind mod+r spawn dmenu_run
# nibar's applications menu
bind mod+p emit menu

# autostart runs once at login, not on reload
autostart nibar
# autostart feh --bg-fill /usr/share/backgrounds/ynnios/01_debian_crimson.png

# ---- windows ---------------------------------------------------------------
bind mod+shift+c kill
bind mod+j focus next
bind mod+k focus prev
bind mod+shift+j swap next
bind mod+shift+k swap prev
bind mod+ctrl+Return zoom
bind mod+ctrl+space float
bind mod+f fullscreen

# ---- layouts -----------------------------------------------------------------
bind mod+space layout next
bind mod+t layout tile
bind mod+m layout monocle
bind mod+g layout grid
bind mod+shift+f layout float
bind mod+l mfact +0.05
bind mod+h mfact -0.05
bind mod+shift+h nmaster +1
bind mod+shift+l nmaster -1

# ---- monitors ----------------------------------------------------------------
# Every monitor has its own tags. 1 is the primary monitor.
bind mod+period focusmon next
bind mod+comma focusmon prev
bind mod+shift+period tagmon next
bind mod+shift+comma tagmon prev

# ---- tags --------------------------------------------------------------------
bind mod+Tab view prev
bind mod+0 view all
bind mod+shift+0 tag all
bind mod+1 view 1
bind mod+2 view 2
bind mod+3 view 3
bind mod+4 view 4
bind mod+5 view 5
bind mod+6 view 6
bind mod+7 view 7
bind mod+8 view 8
bind mod+9 view 9
bind mod+shift+1 tag 1
bind mod+shift+2 tag 2
bind mod+shift+3 tag 3
bind mod+shift+4 tag 4
bind mod+shift+5 tag 5
bind mod+shift+6 tag 6
bind mod+shift+7 tag 7
bind mod+shift+8 tag 8
bind mod+shift+9 tag 9
bind mod+ctrl+1 toggleview 1
bind mod+ctrl+2 toggleview 2
bind mod+ctrl+3 toggleview 3
bind mod+ctrl+4 toggleview 4
bind mod+ctrl+5 toggleview 5
bind mod+ctrl+6 toggleview 6
bind mod+ctrl+7 toggleview 7
bind mod+ctrl+8 toggleview 8
bind mod+ctrl+9 toggleview 9
bind mod+ctrl+shift+1 toggletag 1
bind mod+ctrl+shift+2 toggletag 2
bind mod+ctrl+shift+3 toggletag 3
bind mod+ctrl+shift+4 toggletag 4
bind mod+ctrl+shift+5 toggletag 5
bind mod+ctrl+shift+6 toggletag 6
bind mod+ctrl+shift+7 toggletag 7
bind mod+ctrl+shift+8 toggletag 8
bind mod+ctrl+shift+9 toggletag 9

# ---- media keys --------------------------------------------------------------
bind XF86AudioRaiseVolume spawn amixer -q set Master 5%+
bind XF86AudioLowerVolume spawn amixer -q set Master 5%-
bind XF86AudioMute spawn amixer -q set Master toggle

# ---- session -----------------------------------------------------------------
bind mod+ctrl+r reload
bind mod+shift+q quit

# ---- rules -------------------------------------------------------------------
# match class=, instance= (exact) or title= (substring); then float, tile,
# tag N, monitor N, scratchpad (that window becomes the scratchpad), noswallow (never
# swallows its terminal) or terminal (counts as a terminal for swallowing)
rule class=mpv float
rule title=Picture-in-Picture float
# rule class=Gimp noswallow
# rule class=Firefox tag 2
