# nni family overlay - generated by tools/release.sh from packaging/gentoo/nni-base.ebuild.in
EAPI=8

inherit toolchain-funcs

DESCRIPTION="Shared core of the nni family: nni, svc, wifi, spol, boot script, chicken logos"
HOMEPAGE="@REPO_URL@"
SRC_URI="@REPO_URL@/releases/download/v${PV}/nni-${PV}.tar.gz"
S="${WORKDIR}/nni-${PV}"

LICENSE="MIT"
SLOT="0"
KEYWORDS="~amd64"

RDEPEND="
	sys-apps/busybox
	app-misc/fastfetch
"

src_compile() {
	emake CC="$(tc-getCC)" CFLAGS="${CFLAGS}" LDFLAGS="${LDFLAGS}"
}

src_install() {
	emake DESTDIR="${D}" DISTRO=sgnnios REPO_URL="@REPO_URL@" install
	einstalldocs
}

pkg_postinst() {
	if [[ -z ${ROOT} || ${ROOT} == / ]]; then
		/usr/bin/nni setup --distro sgnnios || ewarn "'nni setup' had a problem; run it again by hand"
	fi
	elog "SGnniOS settings: nni list   services: svc list   help: handbook"
	elog "Chickens instead of penguins at boot: see 'Boot logo' in the handbook."
}
