# nni family overlay - generated by tools/release.sh from packaging/gentoo/niwm.ebuild.in
EAPI=8

inherit toolchain-funcs

DESCRIPTION="NiWM: lightweight tiling and floating window manager, with the nibar taskbar"
HOMEPAGE="https://github.com/initramfs20-ai/nni"
# NiWM has its own version; its source rides along with the nni release
SRC_URI="https://github.com/initramfs20-ai/nni/releases/download/v1.1.0/niwm-${PV}.tar.gz"
S="${WORKDIR}/niwm-${PV}"

LICENSE="MIT"
SLOT="0"
KEYWORDS="~amd64"

DEPEND="x11-libs/libxcb:="
RDEPEND="${DEPEND}"
BDEPEND="virtual/pkgconfig"

src_compile() {
	emake CC="$(tc-getCC)" PKG_CONFIG="$(tc-getPKG_CONFIG)" \
		CFLAGS="${CFLAGS}" LDFLAGS="${LDFLAGS}" RANDR=yes XRES=yes
}

src_install() {
	emake DESTDIR="${D}" PREFIX="${EPREFIX}/usr" SYSCONFDIR="${EPREFIX}/etc" install
	einstalldocs
}

pkg_postinst() {
	elog "Start NiWM from ~/.xinitrc with:  exec niwm-x11"
	elog "Your own settings:  mkdir -p ~/.config/niwm && cp /etc/niwm/niwmrc ~/.config/niwm/"
	elog "Keys and everything else:  man niwm   man nibar"
}
